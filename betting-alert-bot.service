[Unit]
Description=Bot de alertas de mercado (BetsAPI -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/betting_alert_bot
ExecStart=/opt/betting_alert_bot/venv/bin/python /opt/betting_alert_bot/main.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/betting_alert_bot/.env

[Install]
WantedBy=multi-user.target
